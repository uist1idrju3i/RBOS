config NRFX_RESERVED_RESOURCES_HEADER
	default "rbos_reserved_resources.h"

menu "RBOS application"

config RBOS_WDT
	bool "Foreground progress watchdog"
	default y
	select NRFX_WDT

config RBOS_WDT_TIMEOUT_MS
	int "Watchdog timeout (ms)"
	range 100 60000
	default 2000

config RBOS_FATAL_REBOOT
	bool "Reboot after fatal instead of halting"
	select REBOOT
	depends on RBOS_WDT

config RBOS_FATAL_FLUSH_MS
	int "Fatal log flush deadline (ms)"
	range 1 1000
	default 100

config RBOS_FAULT_WDT
	bool "Stall native supervisor to exercise watchdog reset"
	depends on RBOS_WDT && DEBUG_OPTIMIZATIONS && !RBOS_FATAL_REBOOT
	default n

config RBOS_GPIO
	bool "RBOS board GPIO and Button API"
	default y

config RBOS_PERIPHERAL_EXERCISE
	bool "Run the P2 LED/Button diagnostic task after selftests"
	default y
	depends on RBOS_GPIO && !RBOS_TEST_PROFILE_OOM

choice RBOS_TEST_PROFILE
	prompt "Ruby test profile"
	default RBOS_TEST_PROFILE_SELFTEST

config RBOS_TEST_PROFILE_SELFTEST
	bool "User selftests"

config RBOS_TEST_PROFILE_STRESS
	bool "Selftests followed by always-ready spinners"

config RBOS_TEST_PROFILE_OOM
	bool "Retained allocations until fatal pool exhaustion"

endchoice

config RBOS_MAX_VM_COUNT
	int "Maximum number of Ruby VMs"
	range 4 32
	default 8

config RBOS_VM_POOL_SIZE
	int "Ruby VM memory pool size"
	range 16384 131072
	default 65536

config RBOS_TIMESLICE_TICK_COUNT
	int "Ruby VM timeslice (ticks)"
	range 1 255
	default 1

config RBOS_SERVICE_INTERVAL_MS
	int "Native supervisor interval (ms)"
	range 1 1000
	default 10

config RBOS_STATS_INTERVAL_MS
	int "Runtime statistics interval (ms)"
	range 100 3600000
	default 10000

config RBOS_VM_NDEBUG
	bool "Disable assertions in mruby/c sources"

module=RBOS
module-str=RBOS
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
